    },
    {
      "from": "has_lock",
      "to": "diff",
      "label": "да: просмотр",
      "variant": "dashed"
    },
    {
      "from": "own_skills",
      "to": "init",
      "label": "нет",
      "variant": "emphasis"
    },
    {
      "from": "own_skills",
      "to": "adopt",
      "label": "да"
    },
    {
      "from": "diff",
      "to": "update",
      "label": "обновить"
    },
    {
      "from": "init",
      "to": "health",
