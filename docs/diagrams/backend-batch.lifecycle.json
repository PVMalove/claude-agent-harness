  "states": [
    {"id": "planned", "type": "start", "label": "Planned", "sublabel": "ticket, zone, DoD", "lane": "main", "col": 0, "step": "01"},
    {"id": "awaiting", "type": "waiting", "label": "Awaiting approval", "sublabel": "batch or next dispatch", "lane": "main", "col": 1, "step": "02"},
    {"id": "active", "type": "active", "label": "Active", "sublabel": "explicitly approved", "lane": "main", "col": 2, "step": "03"},
    {"id": "reported", "type": "decision", "label": "Report received", "sublabel": "immutable evidence", "lane": "main", "col": 3, "step": "04"},
    {"id": "completed", "type": "success", "label": "Completed", "sublabel": "accepted evidence", "lane": "main", "col": 4, "step": "05"},
    {"id": "blocked", "type": "waiting", "label": "Blocked", "sublabel": "missing input or conflict", "lane": "waiting", "col": 1, "tag": "new decision"},
