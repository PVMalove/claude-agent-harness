    {"from": "active", "to": "reported"},
    {"from": "reported", "to": "completed"},
    {"from": "reported", "to": "blocked", "variant": "security", "route": "drop"},
    {"from": "active", "to": "failed", "variant": "security", "fromSide": "left", "toSide": "left", "via": [[320, 157], [320, 385]]}
  ],
  "cards": [
    {"dot": "amber", "title": "Approval boundary", "items": ["No role starts before explicit approval", "Each next dispatch needs a fresh decision"]},
    {"dot": "emerald", "title": "Evidence boundary", "items": ["Every dispatch produces immutable evidence", "A failed or blocked batch needs a new decision"]}
  ]
