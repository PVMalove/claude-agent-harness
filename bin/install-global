#!/usr/bin/env bash
set -euo pipefail

# On Windows/MSYS (Git Bash), `ln -s` without SeCreateSymbolicLinkPrivilege silently
# falls back to copying files / creating plain directories instead of real reparse-point
# symlinks - a broken "link" that install_link()/retire_entries() below, and any runtime
# that walks these directories, cannot tell apart from a real file/directory. nativestrict
# forces real symlinks (works under Windows Developer Mode) and errors loudly instead of
# silently faking it. A no-op outside MSYS - GNU coreutils elsewhere ignores this variable.
export MSYS="${MSYS:-winsymlinks:nativestrict}"

C_BLUE='\033[1;34m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[1;31m'
C_CYAN='\033[1;36m'
C_RESET='\033[0m'

usage() {
  cat <<EOF
Usage: install-global --target-home <dir> --runtime codex|claude|kimi|opencode|hermes [--runtime ...]
                      [--check] [--replace-conflicts] [--skills-only]

Installs a minimal instruction profile plus start-project. It never installs MCP, models, plugins,
credentials, or permissions.
EOF
}

TARGET_HOME=""
CHECK=0
REPLACE=0
SKILLS_ONLY=0
RUNTIMES=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --target-home) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; TARGET_HOME="$2"; shift 2 ;;
    --runtime) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; RUNTIMES+=("$2"); shift 2 ;;
    --check) CHECK=1; shift ;;
    --replace-conflicts) REPLACE=1; shift ;;
    --skills-only) SKILLS_ONLY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

[ -n "$TARGET_HOME" ] && [ "${#RUNTIMES[@]}" -gt 0 ] || { usage >&2; exit 2; }
TARGET_HOME="$(cd "$TARGET_HOME" 2>/dev/null && pwd -P)" || {
  echo -e "${C_RED}[ERROR] Target home must already exist: $TARGET_HOME${C_RESET}" >&2
  exit 1
}

KIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
PROFILE="$KIT_ROOT/global/AGENTS.md"
ENTRY_SKILLS=(start-project)
RETIRED_ENTRY_SKILLS=(project-harness-bootstrap skill-library)
BACKUP_ROOT=""

echo -e "${C_BLUE}======================================================${C_RESET}"
echo -e "${C_CYAN} Starting Agent Global Setup${C_RESET}"
echo -e "${C_BLUE}======================================================${C_RESET}"
echo -e "Target Home Directory: ${C_GREEN}${TARGET_HOME}${C_RESET}"
echo -e "Source Kit Root:       ${C_GREEN}${KIT_ROOT}${C_RESET}"
if [ "$CHECK" = "1" ]; then echo -e "${C_YELLOW}Mode: CHECK (Dry Run)${C_RESET}"; fi

backup_target() {
  local target="$1" relative
  [ -n "$BACKUP_ROOT" ] || BACKUP_ROOT="$TARGET_HOME/.agent-harness-backups/$(date +%Y%m%d-%H%M%S)"
  relative="${target#"$TARGET_HOME"/}"
  mkdir -p "$BACKUP_ROOT/$(dirname "$relative")"
  mv "$target" "$BACKUP_ROOT/$relative"
  echo -e "  ${C_YELLOW}[BACKUP]${C_RESET} Moved existing to $BACKUP_ROOT/$relative"
}

install_file() {
  local source="$1" target="$2"
  if [ -e "$target" ] || [ -L "$target" ]; then
    cmp -s "$source" "$target" && { echo -e "  ${C_GREEN}[OK]${C_RESET} Profile already matches: $target"; return 0; }
    [ "$CHECK" = "0" ] && [ "$REPLACE" = "1" ] || {
      echo -e "  ${C_RED}[CONFLICT]${C_RESET} File differs: $target" >&2
      return 1
    }
    backup_target "$target"
  elif [ "$CHECK" = "1" ]; then
    echo -e "  ${C_RED}[MISSING]${C_RESET} $target" >&2
    return 1
  fi
  mkdir -p "$(dirname "$target")"
  cp "$source" "$target"
  echo -e "  ${C_GREEN}[WRITE]${C_RESET} Copied profile to: $target"
}

install_link() {
  local source="$1" target="$2" resolved=""
  if [ -L "$target" ]; then
    resolved="$(realpath "$target" 2>/dev/null || true)"
    [ "$resolved" = "$source" ] && { echo -e "  ${C_GREEN}[OK]${C_RESET} Skill linked correctly: $target"; return 0; }
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    [ "$CHECK" = "0" ] && [ "$REPLACE" = "1" ] || {
      echo -e "  ${C_RED}[CONFLICT]${C_RESET} Target exists but is not correct link: $target" >&2
      return 1
    }
    backup_target "$target"
  elif [ "$CHECK" = "1" ]; then
    echo -e "  ${C_RED}[MISSING]${C_RESET} Link $target" >&2
    return 1
  fi
  mkdir -p "$(dirname "$target")"
  ln -s "$source" "$target"
  echo -e "  ${C_GREEN}[LINK]${C_RESET} Created link: $target -> $source"
}

install_entries() {
  local destination="$1" name source
  for name in "${ENTRY_SKILLS[@]}"; do
    source="$KIT_ROOT/global-skills/$name"
    [ -f "$source/SKILL.md" ] || { echo -e "  ${C_RED}[ERROR]${C_RESET} Missing entry skill source: $source" >&2; return 1; }
    install_link "$source" "$destination/$name" || return 1
  done
}

retire_entries() {
  local destination="$1" name target expected current
  for name in "${RETIRED_ENTRY_SKILLS[@]}"; do
    target="$destination/$name"
    [ -e "$target" ] || [ -L "$target" ] || continue
    expected="$KIT_ROOT/global-skills/$name"
    if [ ! -L "$target" ]; then
      echo -e "  ${C_RED}[CONFLICT]${C_RESET} Retired managed entry is not a symlink: $target" >&2
      return 1
    fi
    current="$(readlink "$target")"
    if [ "$current" != "$expected" ]; then
      echo -e "  ${C_RED}[CONFLICT]${C_RESET} Retired entry has a foreign target: $target -> $current" >&2
      return 1
    fi
    if [ "$CHECK" = "1" ]; then
      echo -e "  ${C_RED}[ERROR]${C_RESET} Retired entry still installed: $target" >&2
      return 1
    fi
    unlink "$target"
    echo -e "  ${C_YELLOW}[RETIRE]${C_RESET} Removed legacy skill: $target"
  done
}

status=0
for runtime in "${RUNTIMES[@]}"; do
  echo -e "\n${C_CYAN}>>> Configuring Runtime: ${C_GREEN}${runtime}${C_RESET}"
  case "$runtime" in
    codex)
      [ "$SKILLS_ONLY" = "1" ] || install_file "$PROFILE" "$TARGET_HOME/.codex/AGENTS.md" || status=1
      retire_entries "$TARGET_HOME/.agents/skills" || status=1
      install_entries "$TARGET_HOME/.agents/skills" || status=1
      ;;
    claude)
      [ "$SKILLS_ONLY" = "1" ] || install_file "$PROFILE" "$TARGET_HOME/.claude/CLAUDE.md" || status=1
      retire_entries "$TARGET_HOME/.claude/skills" || status=1
      install_entries "$TARGET_HOME/.claude/skills" || status=1
      ;;
    kimi)
      [ "$SKILLS_ONLY" = "1" ] || install_file "$PROFILE" "$TARGET_HOME/.kimi-code/AGENTS.md" || status=1
      retire_entries "$TARGET_HOME/.agents/skills" || status=1
      install_entries "$TARGET_HOME/.agents/skills" || status=1
      ;;
    opencode)
      [ "$SKILLS_ONLY" = "1" ] || install_file "$PROFILE" "$TARGET_HOME/.config/opencode/AGENTS.md" || status=1
      retire_entries "$TARGET_HOME/.agents/skills" || status=1
      install_entries "$TARGET_HOME/.agents/skills" || status=1
      ;;
    hermes)
      # SOUL.md is identity, not a cross-project rules file. Hermes reads project AGENTS.md.
      echo -e "  ${C_BLUE}[INFO]${C_RESET} Skipping profile for Hermes (reads project AGENTS.md)"
      retire_entries "$TARGET_HOME/.hermes/skills" || status=1
      install_entries "$TARGET_HOME/.hermes/skills" || status=1
      ;;
    *) 
      echo -e "  ${C_RED}[ERROR]${C_RESET} Unknown runtime: $runtime" >&2
      status=1 
      ;;
  esac
done

echo -e "\n${C_BLUE}======================================================${C_RESET}"
if [ "$status" -eq 0 ]; then
  echo -e "${C_GREEN}✔ Installation completed successfully!${C_RESET}"
else
  echo -e "${C_RED}✖ Installation finished with errors (see conflicts above).${C_RESET}"
fi
[ -z "$BACKUP_ROOT" ] || echo -e "Files backed up to: ${C_YELLOW}$BACKUP_ROOT${C_RESET}"
echo -e "${C_BLUE}======================================================${C_RESET}"
exit "$status"
