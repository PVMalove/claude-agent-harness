      "uid": 1000,
      "directory": "/run/user/1000/harness"
    },
    {
      "name": "unix without XDG_RUNTIME_DIR",
      "platform": "unix",
      "xdg_runtime_dir": null,
      "local_app_data": null,
      "uid": 1000,
      "directory": "/tmp/harness-1000"
    },
    {
      "name": "unix with an empty XDG_RUNTIME_DIR",
      "platform": "unix",
      "xdg_runtime_dir": "",
      "local_app_data": null,
      "uid": 0,
      "directory": "/tmp/harness-0"
    },
    {
      "name": "unix with a relative XDG_RUNTIME_DIR",
      "platform": "unix",
      "xdg_runtime_dir": "run/user/1000",
      "local_app_data": null,
      "uid": 1000,
      "directory": "/tmp/harness-1000"
    },
    {
      "name": "unix ignores LOCALAPPDATA",
