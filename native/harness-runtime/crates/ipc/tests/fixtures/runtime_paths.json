      "uid": 0,
      "directory": "C:\\Users\\user\\AppData\\Local\\harness"
    },
    {
      "name": "windows with a relative XDG_RUNTIME_DIR and a trailing separator in LOCALAPPDATA",
      "platform": "windows",
      "xdg_runtime_dir": "run",
