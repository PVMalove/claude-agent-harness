* text=auto eol=lf

# Vendor snapshot is pinned to upstream byte-for-byte (see third_party/mattpocock-skills/SHA256SUMS)
# — must never be line-ending-converted, regardless of a clone's core.autocrlf.
skills/vendor/** -text
third_party/mattpocock-skills/** -text

# Entrypoint/hook scripts execute directly via shebang on Linux/macOS bash; CRLF
# breaks `set -o pipefail` and other builtins immediately on checkout there. Force
# LF regardless of a clone's core.autocrlf.
bin/* text eol=lf
scripts/* text eol=lf
harness/bin/harness.py text eol=lf
harness/project/hooks/*.sh text eol=lf

# Images are binary: a text=auto guess must never normalise their bytes (nine diagram previews
# were once corrupted by a CRLF -> LF rewrite).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
